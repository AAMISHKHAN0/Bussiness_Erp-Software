POSTGRES_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-host.us-east-1.aws.neon.tech/neondb?sslmode=require

# Authentication & Session Security
NEXTAUTH_SECRET=enterprise-erp-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=enterprise-erp-jwt-secret-key-2026-2028
